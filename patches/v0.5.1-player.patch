@@ -0,0 +1,74 @@
+package com.droiddeck.launcher.gpu
+
+import android.content.Context
+import android.os.Build
+import com.droiddeck.launcher.core.Hashes
+import com.droiddeck.launcher.runtime.LinuxRuntime
+import com.droiddeck.launcher.session.ComponentsManager
+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+import org.robolectric.util.ReflectionHelpers
+import java.io.File
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28], manifest = Config.NONE)
+class BuiltinProfileTest {
+    private lateinit var context: Context
+
+    @Before fun setUp() {
+        context = RuntimeEnvironment.getApplication()
+        ReflectionHelpers.setStaticField(Build::class.java, "HARDWARE", "mt8797")
+        context.getSharedPreferences("session", Context.MODE_PRIVATE).edit().clear().commit()
+        for (dir in listOf("graphics_driver", "components")) File(context.filesDir, dir).deleteRecursively()
+        LinuxRuntime.rootDir(context).deleteRecursively()
+    }
+
+    @Test fun theDefaultIsLimitedToTheSupportedDevice() {
+        assertTrue(BuiltinProfile.matchesDevice(listOf("MT8797")))
+        assertTrue(BuiltinProfile.matchesDevice(listOf("RP4Pro")))
+        assertTrue(BuiltinProfile.matchesDevice(listOf("Retroid Pocket 4 Pro")))
+        assertFalse(BuiltinProfile.matchesDevice(listOf("Retroid Pocket 4")))
+        assertFalse(BuiltinProfile.matchesDevice(listOf("Retroid Pocket 5")))
+        assertFalse(BuiltinProfile.matchesDevice(listOf("Retroid", "unverified device")))
+    }
+
+    @Test fun preparingAssetsPreservesExistingPlayerPreferences() {
+        val prefs = context.getSharedPreferences("session", Context.MODE_PRIVATE)
+        prefs.edit().putString("androidDriver", "").putString("gpuDriverMode", "manual")
+            .putBoolean("vkBridge", false).putString("steamMenus", "software").commit()
+        BuiltinProfile.prepareForSession(context)
+        assertEquals("", prefs.getString("androidDriver", null))
+        assertEquals("manual", prefs.getString("gpuDriverMode", null))
+        assertFalse(prefs.getBoolean("vkBridge", true))
+        assertEquals("software", prefs.getString("steamMenus", null))
+    }
+
+    @Test fun partialCopiesAreRepairedAndALaterInstalledProtonIsPreparedInTheSameApp() {
+        val driver = File(context.filesDir, "graphics_driver/PanVK_faux123_v1.1.3/libvulkan_panfrost.so")
+        driver.parentFile!!.mkdirs()
+        driver.writeBytes(ByteArray(2_000_000))
+        val wcp = File(context.filesDir, "components/packages/vkd3d-3.1-readback-fallback.wcp")
+        wcp.parentFile!!.mkdirs()
+        wcp.writeBytes(ByteArray(150_000))
+        BuiltinProfile.prepareForSession(context)
+        assertEquals("e2d222b5ab01a209c3e8bdc76ea7985cf3e0c57a709d030b3b3c5d947f5aaea0", Hashes.sha256(driver))
+        assertTrue(File(driver.parentFile, "meta.json").isFile)
+        assertEquals(BuiltinProfile.WCP_HASH, Hashes.sha256(wcp))
+
+        val proton = File(LinuxRuntime.rootDir(context), "root/.local/share/Steam/steamapps/common/Proton Experimental (ARM64)")
+        val dll = File(proton, "files/lib/wine/vkd3d-proton/aarch64-windows/d3d12core.dll")
+        dll.parentFile!!.mkdirs()
+        dll.writeText("stock")
+        File(proton, "proton").writeText("#!/bin/sh\n")
+        File(proton, "version").writeText("1 experimental-v1-arm64\n")
+        BuiltinProfile.prepareForSession(context)
+        val component = ComponentsManager.snapshot(context).protons.single().components.getValue("vkd3d")
+        assertEquals(wcp.name, component.activeFile)
+        assertNotEquals("stock", dll.readBytes().take(5).toByteArray().decodeToString())
+    }
+}
diff --git a/app/src/test/java/com/droiddeck/launcher/session/ComponentsBundledVkd3dTest.kt b/app/src/test/java/com/droiddeck/launcher/session/ComponentsBundledVkd3dTest.kt
new file mode 100644
index 00000000..e863431a
--- /dev/null
+++ b/app/src/test/java/com/droiddeck/launcher/session/ComponentsBundledVkd3dTest.kt
@@ -0,0 +1,109 @@
+package com.droiddeck.launcher.session
+
+import android.content.Context
+import com.droiddeck.launcher.core.Hashes
+import com.droiddeck.launcher.runtime.LinuxRuntime
+import com.github.luben.zstd.ZstdOutputStream
+import org.apache.commons.compress.archivers.tar.TarArchiveEntry
+import org.apache.commons.compress.archivers.tar.TarArchiveOutputStream
+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+import java.io.File
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28], manifest = Config.NONE)
+class ComponentsBundledVkd3dTest {
+    private lateinit var context: Context
+    private lateinit var proton: File
+    private lateinit var bundle: File
+    private val relative = "files/lib/wine/vkd3d-proton/aarch64-windows/d3d12core.dll"
+
+    @Before fun setUp() {
+        context = RuntimeEnvironment.getApplication()
+        File(context.filesDir, "components").deleteRecursively()
+        LinuxRuntime.rootDir(context).deleteRecursively()
+        proton = File(LinuxRuntime.rootDir(context), "root/.local/share/Steam/steamapps/common/Proton Experimental (ARM64)")
+        File(proton, relative).apply { parentFile!!.mkdirs(); writeText("original v1") }
+        File(proton, "proton").writeText("#!/bin/sh\n")
+        File(proton, "version").writeText("1 experimental-v1-arm64\n")
+        bundle = packageFile("bundled.wcp", "bundled readback")
+    }
+
+    @Test fun firstPreparationSavesOriginalAndRepairsASameVersionReinstall() {
+        assertTrue(prepare())
+        assertEquals("bundled readback", File(proton, relative).readText())
+        val original = File(context.filesDir, "components/originals/${id()}/experimental-v1-arm64/vkd3d.wcp")
+        assertTrue(original.isFile)
+        val backup = Hashes.sha256(original)
+        assertTrue(prepare())
+        assertEquals(backup, Hashes.sha256(original))
+        File(proton, relative).writeText("original v1")
+        assertTrue(prepare())
+        assertEquals("bundled readback", File(proton, relative).readText())
+        assertEquals(backup, Hashes.sha256(original))
+    }
+
+    @Test fun aProtonUpdateGetsItsOwnBackupAndTheDefaultWithoutRestartingTheApp() {
+        prepare()
+        updateProton()
+        assertTrue(prepare())
+        assertEquals("bundled readback", File(proton, relative).readText())
+        ComponentsManager.restore(context, id(), "vkd3d", "experimental-v2-arm64")
+        assertEquals("original v2", File(proton, relative).readText())
+    }
+
+    @Test fun restoringOriginalOptsOutEvenAcrossProtonUpdates() {
+        prepare()
+        ComponentsManager.restore(context, id(), "vkd3d", "experimental-v1-arm64")
+        assertFalse(prepare())
+        assertEquals("original v1", File(proton, relative).readText())
+        updateProton()
+        assertFalse(prepare())
+        assertEquals("original v2", File(proton, relative).readText())
+    }
+
+    @Test fun anExistingPlayerPackageIsPreserved() {
+        packageFile("player.wcp", "player selected")
+        ComponentsManager.swap(context, id(), "player.wcp")
+        assertFalse(prepare())
+        assertEquals("player selected", File(proton, relative).readText())
+    }
+
+    @Test fun aLegacyRestoredOriginalIsNotOverwrittenDuringMigration() {
+        assertFalse(ComponentsManager.ensureBundledVkd3d(context, id(), bundle.name, Hashes.sha256(bundle), legacyApplied = true))
+        assertEquals("original v1", File(proton, relative).readText())
+    }
+
+    @Test fun aBadPackageCannotModifyTheProton() {
+        assertThrows(IllegalStateException::class.java) {
+            ComponentsManager.ensureBundledVkd3d(context, id(), bundle.name, "0".repeat(64))
+        }
+        assertEquals("original v1", File(proton, relative).readText())
+    }
+
+    private fun prepare() = ComponentsManager.ensureBundledVkd3d(context, id(), bundle.name, Hashes.sha256(bundle))
+    private fun id() = ComponentsManager.protons(context).single().id
+    private fun updateProton() {
+        File(proton, "version").writeText("2 experimental-v2-arm64\n")
+        File(proton, relative).writeText("original v2")
+    }
+
+    private fun packageFile(name: String, contents: String): File {
+        val file = File(context.filesDir, "components/packages/$name")
+        file.parentFile!!.mkdirs()
+        TarArchiveOutputStream(ZstdOutputStream(file.outputStream())).use { tar ->
+            for ((path, text) in mapOf("profile.json" to """{"type":"VKD3D-Linux","versionName":"test"}""", relative to contents)) {
+                val bytes = text.toByteArray()
+                tar.putArchiveEntry(TarArchiveEntry(path).apply { size = bytes.size.toLong() })
+                tar.write(bytes)
+                tar.closeArchiveEntry()
+            }
+        }
+        return file
+    }
+}
