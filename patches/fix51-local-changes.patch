+);
+
+static int svc_emit(uint32_t *code, uint32_t *site, uint32_t *branch) {
+  uint32_t back;
+  if (!svc_branch((uintptr_t)site, (uintptr_t)code, branch) ||
+      !svc_branch((uintptr_t)(code + 5), (uintptr_t)(site + 1), &back)) return 0;
+  code[0] = 0xa9bf47f0U; /* stp x16, x17, [sp, #-16]! */
+  code[1] = 0x580000f0U; /* ldr x16, literal at +32 */
+  code[2] = 0x10000051U; /* adr x17, +8 */
+  code[3] = 0xd61f0200U; /* br x16 */
+  code[4] = 0xa8c147f0U; /* ldp x16, x17, [sp], #16 */
+  code[5] = back;
+  uintptr_t entry = (uintptr_t)fp_svc_entry;
+  uintptr_t resume = (uintptr_t)(site + 1);
+  memcpy(code + 6, &resume, sizeof resume);
+  memcpy(code + 8, &entry, sizeof entry);
+  return 1;
+}
+
+struct svc_site { uint32_t *site; uint32_t branch; };
+static struct svc_site svc_plan[256];
+static size_t svc_planned;
+
+#include "svc-cache.h"
+
+static int svc_object(struct dl_phdr_info *info, size_t size, void *unused) {
+  (void)size;
+  (void)unused;
+  const char *name = strrchr(info->dlpi_name, '/');
+  name = name ? name + 1 : info->dlpi_name;
+  if (strcmp(name, "libc.so.6") && strcmp(name, "ld-linux-aarch64.so.1")) return 0;
+  char cache[224];
+  int cached = svc_cache_name(info, cache, sizeof cache);
+  if (cached && svc_cache_read(info, cache)) { svc_cache_hits++; return 0; }
+  if (cached) svc_cache_misses++;
+  size_t first = svc_planned;
+  for (int i = 0; i < info->dlpi_phnum; i++) {
+    const ElfW(Phdr) *ph = &info->dlpi_phdr[i];
+    if (ph->p_type != PT_LOAD || !(ph->p_flags & PF_X)) continue;
+    uint32_t *text = (uint32_t *)(info->dlpi_addr + ph->p_vaddr);
+    for (size_t j = 1; j < ph->p_memsz / 4 && svc_planned < 256; j++) {
+      if (text[j] != 0xd4000001U) continue;
+      int nr = svc_site_number(text, j);
+      if (!svc_supported(nr)) continue;
+      svc_plan[svc_planned++].site = &text[j];
+    }
+  }
+  if (cached) svc_cache_write(info, cache, first);
+  return 0;
+}
+
+static uint32_t *svc_relay_page(uintptr_t site, size_t page) {
+  uintptr_t base = site & ~(uintptr_t)(page - 1);
+  for (uintptr_t delta = page; delta < 0x7ff0000UL; delta += 0x10000UL) {
+    for (int direction = -1; direction <= 1; direction += 2) {
+      uintptr_t at = direction < 0 ? base - delta : base + delta;
+      if (at < page) continue;
+      void *p = mmap((void *)at, page, PROT_READ | PROT_WRITE,
+                     MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+      if (p == (void *)at) return p;
+      if (p != MAP_FAILED) munmap(p, page);
+    }
+  }
+  return NULL;
+}
+
+#include "svc-publish.h"
+
+static int svc_single_thread(void) {
+  struct entry { uint64_t ino; int64_t off; unsigned short len; unsigned char type; char name[]; };
+  char buf[4096] __attribute__((aligned(8)));
+  long fd = sc(SYS_openat, AT_FDCWD, (long)"/proc/self/task", O_RDONLY | O_DIRECTORY | O_CLOEXEC, 0, 0);
+  if (fd < 0) return 0;
+  int count = 0;
+  long n;
+  while ((n = sc(SYS_getdents64, fd, (long)buf, sizeof buf, 0, 0)) > 0) {
+    for (long at = 0; at < n;) {
+      const struct entry *e = (const struct entry *)(buf + at);
+      if (n - at < (long)offsetof(struct entry, name) + 1 ||
+          e->len < offsetof(struct entry, name) + 1 || e->len > n - at) { count = -1; goto done; }
+      if (e->name[0] >= '0' && e->name[0] <= '9' && ++count > 1) goto done;
+      at += e->len;
+    }
+  }
+  if (n < 0) count = -1;
+done:
+  sc(SYS_close, fd, 0, 0, 0, 0);
+  return count == 1;
+}
+
+static void svc_stats(void) {
+  char line[256];
+  int n = snprintf(line, sizeof line, "fastpath-svc[%d]: %u sites, %u relay pages, %lu fast, %lu to proot; scan %llu us, patch %llu us, android %d, cache %u hit %u miss\n",
+                   getpid(), svc_sites, svc_pages, svc_fast, svc_slow, svc_scan_ns / 1000, svc_patch_ns / 1000, svc_android_api, svc_cache_hits, svc_cache_misses);
+  if (n > 0 && write(2, line, n < (int)sizeof line ? n : (int)sizeof line - 1) < 0) {}
+}
+
+static unsigned long long svc_clock(void) {
+  struct timespec t;
+  if (sc(SYS_clock_gettime, CLOCK_MONOTONIC, (long)&t, 0, 0, 0) < 0) return 0;
+  return (unsigned long long)t.tv_sec * 1000000000ULL + t.tv_nsec;
+}
+
+static void svc_child(void) { svc_busy = 0; }
+
+__attribute__((constructor)) static void svc_patch_init(void) {
+  const char *enabled = getenv("PROOT_FP_PATCH_SVC");
+  if ((enabled && strcmp(enabled, "1")) || !fp_ready()) return;
+  if (getauxval(AT_HWCAP) & HWCAP_SVE) return;
+#ifdef HWCAP2_SME
+  if (getauxval(AT_HWCAP2) & HWCAP2_SME) return;
+#endif
+  if (!svc_single_thread()) return;
+  if (pthread_atfork(NULL, NULL, svc_child)) return;
+  svc_android_api = svc_host_android_api();
+  size_t page = (size_t)sysconf(_SC_PAGESIZE);
+  if (page < 4096 || (page & (page - 1))) return;
+  int mem = (int)sc(SYS_openat, AT_FDCWD, (long)"/proc/self/mem", O_RDWR | O_CLOEXEC, 0, 0);
+  if (mem < 0) return;
+  unsigned long long start = svc_clock();
+  dl_iterate_phdr(svc_object, NULL);
+  svc_scan_ns = svc_clock() - start;
+  start = svc_clock();
+  svc_publish(mem, page);
+  sc(SYS_close, mem, 0, 0, 0, 0);
+  svc_patch_ns = svc_clock() - start;
+  if (getenv("PROOT_FP_STATS")) atexit(svc_stats);
+}
+#endif
diff --git a/tools/proot/fastpath/svc-publish.h b/tools/proot/fastpath/svc-publish.h
new file mode 100644
index 00000000..002e06c5
--- /dev/null
+++ b/tools/proot/fastpath/svc-publish.h
@@ -0,0 +1,28 @@
+static void svc_publish(int mem, size_t page) {
+  for (size_t first = 0; first < svc_planned;) {
+    uint32_t *relay = svc_relay_page((uintptr_t)svc_plan[first].site, page);
+    if (!relay) { first++; continue; }
+    size_t end = first;
+    for (; end < svc_planned && (end - first + 1) * 40 <= page; end++) {
+      uint32_t *code = relay + (end - first) * 10;
+      if (!svc_emit(code, svc_plan[end].site, &svc_plan[end].branch)) break;
+    }
+    __builtin___clear_cache((char *)relay, (char *)relay + page);
+    if (end == first || mprotect(relay, page, PROT_READ | PROT_EXEC)) {
+      munmap(relay, page);
+      first++;
+      continue;
+    }
+    unsigned patched = 0;
+    for (size_t i = first; i < end; i++) {
+      struct svc_site *s = &svc_plan[i];
+      long written = sc(SYS_pwrite64, mem, (long)&s->branch, sizeof s->branch, (long)s->site, 0);
+      if (written != sizeof s->branch) continue;
+      __builtin___clear_cache((char *)s->site, (char *)(s->site + 1));
+      patched++;
+    }
+    if (patched) { svc_sites += patched; svc_pages++; }
+    else munmap(relay, page);
+    first = end;
+  }
+}
diff --git a/tools/proot/fastpath/svc-stack.h b/tools/proot/fastpath/svc-stack.h
new file mode 100644
index 00000000..d3a4ff52
--- /dev/null
+++ b/tools/proot/fastpath/svc-stack.h
@@ -0,0 +1,83 @@
+#include <sys/resource.h>
+#include <string.h>
+
+static __thread uintptr_t svc_stack_low __attribute__((tls_model("initial-exec")));
+static __thread uintptr_t svc_stack_high __attribute__((tls_model("initial-exec")));
+static __thread uintptr_t svc_stack_gap __attribute__((tls_model("initial-exec")));
+static __thread int svc_stack_main __attribute__((tls_model("initial-exec")));
+
+static int svc_hex(const char **text, uintptr_t *value) {
+  const char *p = *text;
+  uintptr_t n = 0;
+  int digits = 0;
+  for (;; p++) {
+    unsigned c = (unsigned char)*p;
+    unsigned d = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : 16;
+    if (d == 16) break;
+    if (++digits > (int)(2 * sizeof n)) return 0;
+    n = (n << 4) | d;
+  }
+  *text = p;
+  *value = n;
+  return digits > 0;
+}
+
+static int svc_stack_line(const char *line, uintptr_t sp, uintptr_t *low, uintptr_t *high) {
+  uintptr_t a, b;
+  if (!svc_hex(&line, &a) || *line++ != '-' || !svc_hex(&line, &b) ||
+      *line++ != ' ' || line[0] != 'r' || line[1] != 'w' || a >= b || sp < a || sp >= b) return 0;
+  *low = a;
+  *high = b;
+  return 1;
+}
+
+static __attribute__((noinline)) int svc_stack_find(uintptr_t sp) {
+  char chunk[512], line[96];
+  size_t at = 0;
+  long fd = sc(SYS_openat, AT_FDCWD, (long)"/proc/self/maps", O_RDONLY | O_CLOEXEC, 0, 0);
+  if (fd < 0) return 0;
+  long n;
+  uintptr_t low = 0, high = 0, previous = 0;
+  int found = 0;
+  while (!found && (n = sc(SYS_read, fd, (long)chunk, sizeof chunk, 0, 0)) > 0) {
+    for (long i = 0; i < n; i++) {
+      if (chunk[i] == '\n') {
+        line[at] = 0;
+        found = svc_stack_line(line, sp, &low, &high);
+        if (!found) {
+          const char *p = line;
+          uintptr_t a, b;
+          if (svc_hex(&p, &a) && *p++ == '-' && svc_hex(&p, &b) && b <= sp) previous = b;
+        }
+        at = 0;
+        if (found) break;
+      } else if (at < sizeof line - 1) line[at++] = chunk[i];
+    }
+  }
+  sc(SYS_close, fd, 0, 0, 0, 0);
+  if (found) {
+    svc_stack_low = 0;
+    svc_stack_high = high;
+    svc_stack_main = strstr(line, "[stack]") != NULL;
+    svc_stack_gap = previous < low && low - previous > 16 * 1024 * 1024 ? previous + 16 * 1024 * 1024 : low;
+    svc_stack_low = low;
+  }
+  return found;
+}
+
+static int svc_stack_room(uintptr_t sp) {
+  stack_t alt;
+  if (sc(SYS_sigaltstack, 0, (long)&alt, 0, 0, 0) < 0 || (alt.ss_flags & SS_ONSTACK)) return 0;
+  if (!svc_stack_low || sp < svc_stack_low || sp >= svc_stack_high)
+    if (!svc_stack_find(sp)) return 0;
+  uintptr_t low = svc_stack_low;
+  if (svc_stack_main) {
+    struct rlimit limit;
+    if (sc(SYS_prlimit64, 0, RLIMIT_STACK, 0, (long)&limit, 0) < 0) return 0;
+    uintptr_t grow = limit.rlim_cur >= svc_stack_high ? 0 : svc_stack_high - limit.rlim_cur;
+    if (grow < svc_stack_gap) grow = svc_stack_gap;
+    if (grow < low) low = grow;
+  }
+  /* Path translation nests several PATH_MAX-sized frames. */
+  return sp - low >= 96 * 1024;
+}
