diff --git a/tools/proot/fastpath/svc-cache.h b/tools/proot/fastpath/svc-cache.h
new file mode 100644
index 00000000..57c1be4b
--- /dev/null
+++ b/tools/proot/fastpath/svc-cache.h
@@ -0,0 +1,90 @@
+struct svc_cached_sites {
+  uint64_t magic;
+  uint32_t api, count;
+  uint64_t offset[256];
+};
+static unsigned svc_cache_hits, svc_cache_misses;
+
+static int svc_segment(const struct dl_phdr_info *info, uint64_t at, size_t length, unsigned flags) {
+  for (int i = 0; i < info->dlpi_phnum; i++) {
+    const ElfW(Phdr) *p = &info->dlpi_phdr[i];
+    if (p->p_type == PT_LOAD && (p->p_flags & flags) == flags &&
+        at >= p->p_vaddr && at - p->p_vaddr <= p->p_memsz &&
+        length <= p->p_memsz - (at - p->p_vaddr)) return i + 1;
+  }
+  return 0;
+}
+
+static int svc_cache_name(const struct dl_phdr_info *info, char *path, size_t size) {
+  const char *enabled = getenv("PROOT_FP_SVC_CACHE");
+  if (enabled && strcmp(enabled, "1")) return 0;
+  for (int i = 0; i < info->dlpi_phnum; i++) {
+    const ElfW(Phdr) *p = &info->dlpi_phdr[i];
+    if (p->p_type != PT_NOTE || !svc_segment(info, p->p_vaddr, p->p_memsz, PF_R)) continue;
+    const unsigned char *note = (const unsigned char *)(info->dlpi_addr + p->p_vaddr);
+    for (size_t at = 0; p->p_memsz - at >= sizeof(ElfW(Nhdr));) {
+      ElfW(Nhdr) h;
+      memcpy(&h, note + at, sizeof h);
+      at += sizeof h;
+      size_t name = ((size_t)h.n_namesz + 3) & ~(size_t)3;
+      size_t desc = ((size_t)h.n_descsz + 3) & ~(size_t)3;
+      if (name > p->p_memsz - at || desc > p->p_memsz - at - name) break;
+      if (h.n_type == NT_GNU_BUILD_ID && h.n_namesz == 4 && !memcmp(note + at, "GNU", 4) &&
+          h.n_descsz && h.n_descsz <= 64) {
+        char id[129];
+        static const char hex[] = "0123456789abcdef";
+        for (size_t j = 0; j < h.n_descsz; j++) {
+          unsigned char b = note[at + name + j];
+          id[2 * j] = hex[b >> 4];
+          id[2 * j + 1] = hex[b & 15];
+        }
+        id[2 * h.n_descsz] = 0;
+        int n = snprintf(path, size, "/tmp/.droiddeck-svc-v2-%d-%s", svc_android_api, id);
+        return n > 0 && (size_t)n < size;
+      }
+      at += name + desc;
+    }
+  }
+  return 0;
+}
+
+static int svc_cache_read(const struct dl_phdr_info *info, const char *path) {
+  long fd = fp_open(AT_FDCWD, path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK, 0);
+  if (fd < 0) return 0;
+  struct stat st;
+  struct svc_cached_sites table;
+  int valid = sc(SYS_fstat, fd, (long)&st, 0, 0, 0) == 0 && S_ISREG(st.st_mode) &&
+              st.st_uid == (uid_t)sc(SYS_getuid, 0, 0, 0, 0, 0) && !(st.st_mode & 0077) &&
+              st.st_size == sizeof table && sc(SYS_read, fd, (long)&table, sizeof table, 0, 0) == sizeof table;
+  sc(SYS_close, fd, 0, 0, 0, 0);
+  if (!valid || table.magic != 0x324356534444ULL || table.api != (unsigned)svc_android_api ||
+      !table.count || table.count > 256 || table.count > 256 - svc_planned) return 0;
+  for (unsigned i = 0; i < table.count; i++) {
+    uint64_t offset = table.offset[i];
+    int segment = svc_segment(info, offset, 4, PF_R | PF_X);
+    if ((offset & 3) || (i && offset <= table.offset[i - 1]) || !segment) return 0;
+    const ElfW(Phdr) *p = &info->dlpi_phdr[segment - 1];
+    const uint32_t *text = (const uint32_t *)(info->dlpi_addr + p->p_vaddr);
+    size_t at = (offset - p->p_vaddr) / 4;
+    if (text[at] != 0xd4000001U || !svc_supported(svc_site_number(text, at))) return 0;
+  }
+  for (unsigned i = 0; i < table.count; i++)
+    svc_plan[svc_planned++].site = (uint32_t *)(info->dlpi_addr + table.offset[i]);
+  return 1;
+}
+
+static void svc_cache_write(const struct dl_phdr_info *info, const char *path, size_t first) {
+  if (svc_planned == first || svc_planned == 256) return;
+  struct svc_cached_sites table = {.magic = 0x324356534444ULL, .api = svc_android_api, .count = svc_planned - first};
+  for (unsigned i = 0; i < table.count; i++)
+    table.offset[i] = (uintptr_t)svc_plan[first + i].site - info->dlpi_addr;
+  char temporary[256];
+  int n = snprintf(temporary, sizeof temporary, "%s.part-%d", path, getpid());
+  if (n <= 0 || n >= (int)sizeof temporary) return;
+  long fd = fp_open(AT_FDCWD, temporary, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+  if (fd < 0) return;
+  long written = sc(SYS_write, fd, (long)&table, sizeof table, 0, 0);
+  sc(SYS_close, fd, 0, 0, 0, 0);
+  if (written == sizeof table) fp_rename(AT_FDCWD, temporary, AT_FDCWD, path, 0);
+  fp_unlink(AT_FDCWD, temporary, 0);
+}
diff --git a/tools/proot/fastpath/svc-dispatch.h b/tools/proot/fastpath/svc-dispatch.h
new file mode 100644
index 00000000..b8e87475
--- /dev/null
+++ b/tools/proot/fastpath/svc-dispatch.h
@@ -0,0 +1,128 @@
+static int svc_android_api;
+
+static int svc_host_android_api(void) {
+  const char *value = getenv("PROOT_FP_ANDROID_API");
+  if (!value || !*value) return 0;
+  char *end;
+  long api = strtol(value, &end, 10);
+  return !*end && api > 0 && api < 1000 ? (int)api : 0;
+}
+
+static long svc_memory(void *local, long remote, size_t size, int write) {
+  if (!size) return 0;
+  struct iovec here = {local, size}, there = {(void *)remote, size};
+  return sc(write ? SYS_process_vm_writev : SYS_process_vm_readv, getpid(),
+            (long)&here, 1, (long)&there, 1);
+}
+
+static int svc_path(long pointer, char *path) {
+  long n = svc_memory(path, pointer, PATH_MAX, 0);
+  return n > 0 && memchr(path, 0, (size_t)n) != NULL;
+}
+
+static long svc_output(long result, void *value, long out, size_t size) {
+  if (result < 0) return result;
+  return svc_memory(value, out, size, 1) == (long)size ? result : FP_SLOW;
+}
+
+static int svc_supported(int nr) {
+  switch (nr) {
+  case SYS_openat: case SYS_newfstatat: case SYS_statx: case SYS_readlinkat:
+  case SYS_faccessat: case SYS_mkdirat: case SYS_unlinkat: case SYS_renameat:
+  case SYS_renameat2: case SYS_symlinkat: case SYS_fchmodat: case SYS_utimensat:
+  case SYS_truncate: case SYS_statfs: case SYS_getxattr: case SYS_lgetxattr:
+  case SYS_listxattr: case SYS_llistxattr: case SYS_inotify_add_watch: case SYS_getcwd:
+    return 1;
+  case SYS_faccessat2:
+    return svc_android_api > 0;
+  case SYS_clone3:
+    return svc_android_api > 0 && svc_android_api < 35;
+  default: return 0;
+  }
+}
+
+static long svc_blocked(const long *r) {
+  if (!svc_android_api) return FP_SLOW;
+  if (r[8] == SYS_faccessat2 || (r[8] == SYS_clone3 && svc_android_api < 35)) return -ENOSYS;
+  return FP_SLOW;
+}
+
+static long svc_path_call(const long *r) {
+#ifdef FP_SVC_TEST_HOOK
+  FP_SVC_TEST_HOOK(r);
+#endif
+  char path[PATH_MAX], other[PATH_MAX];
+  struct timespec times[2];
+  const struct timespec *when = (const struct timespec *)r[2];
+  int first = 1, second = -1;
+  switch (r[8]) {
+  case SYS_getcwd: {
+    if (own_cwd(path) == FP_SLOW) return FP_SLOW;
+    size_t n = strlen(path) + 1;
+    if ((unsigned long)r[1] < n) return -ERANGE;
+    return svc_output(n, path, r[0], n);
+  }
+  case SYS_truncate: case SYS_statfs: case SYS_getxattr: case SYS_lgetxattr:
+  case SYS_listxattr: case SYS_llistxattr: first = 0; break;
+  case SYS_renameat: case SYS_renameat2: second = 3; break;
+  case SYS_symlinkat: first = 0; second = 2; break;
+  case SYS_utimensat:
+    if (when) {
+      if (svc_memory(times, r[2], sizeof times, 0) != sizeof times) return FP_SLOW;
+      for (int i = 0; i < 2; i++)
+        if (times[i].tv_nsec != UTIME_NOW && times[i].tv_nsec != UTIME_OMIT &&
+            (times[i].tv_nsec < 0 || times[i].tv_nsec >= 1000000000L)) return FP_SLOW;
+      when = times;
+    }
+    if (!r[1]) return fp_utimens((int)r[0], NULL, when, (int)r[3]);
+    break;
+  case SYS_inotify_add_watch: {
+    char link[64], target[64];
+    snprintf(link, sizeof link, "/proc/self/fd/%d", (int)r[0]);
+    long n = sc(SYS_readlinkat, AT_FDCWD, (long)link, (long)target, sizeof target - 1, 0);
+    if (n <= 0) return FP_SLOW;
+    target[n] = 0;
+    if (strcmp(target, "anon_inode:inotify")) return FP_SLOW;
+    break;
+  }
+  default:
+    if (!svc_supported((int)r[8])) return FP_SLOW;
+  }
+  if (!svc_path(r[first], path) || (second >= 0 && !svc_path(r[second], other))) return FP_SLOW;
+  switch (r[8]) {
+  case SYS_openat: return fp_open((int)r[0], path, (int)r[2], (mode_t)r[3]);
+  case SYS_newfstatat: {
+    struct stat st;
+    return svc_output(fp_stat((int)r[0], path, (int)r[3], &st), &st, r[2], sizeof st);
+  }
+  case SYS_statx: {
+    struct statx st;
+    return svc_output(fp_statx((int)r[0], path, (int)r[2], (unsigned)r[3], &st), &st, r[4], sizeof st);
+  }
+  case SYS_readlinkat: {
+    char text[PATH_MAX];
+    size_t written = 0;
+    long result = fp_readlink((int)r[0], path, text, (size_t)r[3], &written);
+    return svc_output(result, text, r[2], written);
+  }
+  case SYS_faccessat: return fp_access((int)r[0], path, (int)r[2], 0);
+  case SYS_mkdirat: return fp_mkdir((int)r[0], path, (mode_t)r[2]);
+  case SYS_unlinkat: return fp_unlink((int)r[0], path, (int)r[2]);
+  case SYS_renameat: case SYS_renameat2:
+    return fp_rename((int)r[0], path, (int)r[2], other, r[8] == SYS_renameat2 ? (unsigned)r[4] : 0);
+  case SYS_symlinkat: return fp_symlink(path, (int)r[1], other);
+  case SYS_fchmodat: return fp_chmod((int)r[0], path, (mode_t)r[2], 0);
+  case SYS_utimensat: return fp_utimens((int)r[0], path, when, (int)r[3]);
+  case SYS_truncate: return fp_truncate(path, (off_t)r[1]);
+  case SYS_statfs: {
+    struct statfs st;
+    return svc_output(fp_statfs(path, &st), &st, r[1], sizeof st);
+  }
+  case SYS_getxattr: case SYS_lgetxattr:
+    return fp_getxattr(path, (const char *)r[1], (void *)r[2], (size_t)r[3], r[8] == SYS_getxattr);
+  case SYS_listxattr: case SYS_llistxattr:
+    return fp_listxattr(path, (char *)r[1], (size_t)r[2], r[8] == SYS_listxattr);
+  case SYS_inotify_add_watch: return fp_inotify((int)r[0], path, (uint32_t)r[2]);
+  default: return FP_SLOW;
+  }
+}
diff --git a/tools/proot/fastpath/svc-patch.h b/tools/proot/fastpath/svc-patch.h
new file mode 100644
index 00000000..300302f5
--- /dev/null
+++ b/tools/proot/fastpath/svc-patch.h
@@ -0,0 +1,269 @@
+static inline int svc_number(uint32_t insn) {
+  if ((insn & 0xffe0001fU) == 0xd2800008U ||
+      (insn & 0xffe0001fU) == 0x52800008U)
+    return (insn >> 5) & 0xffff;
+  return -1;
+}
+
+static inline int svc_argument_instruction(uint32_t insn) {
+  if (insn == 0xd503201fU) return 1;
+  if ((insn & 0xffc00000U) == 0x29000000U ||
+      (insn & 0xffc00000U) == 0xa9000000U ||
+      (insn & 0xffc00000U) == 0xb9000000U ||
+      (insn & 0xffc00000U) == 0xf9000000U) return 1;
+  if ((insn & 31) == 8) return 0;
+  return (insn & 0xffe0ffe0U) == 0xaa0003e0U ||
+         (insn & 0xffe0ffe0U) == 0x2a0003e0U ||
+         (insn & 0xfffffc00U) == 0x93407c00U ||
+         (insn & 0x7f800000U) == 0x52800000U ||
+         (insn & 0x7f800000U) == 0x12800000U ||
+         (insn & 0xffc00000U) == 0xb9400000U ||
+         (insn & 0xffc00000U) == 0xf9400000U ||
+         (insn & 0xffc00000U) == 0xb9800000U ||
+         (insn & 0xff000000U) == 0x91000000U ||
+         (insn & 0xff000000U) == 0xd1000000U ||
+         (insn & 0xff000000U) == 0x11000000U ||
+         (insn & 0xff000000U) == 0x51000000U;
+}
+
+static inline int svc_site_number(const uint32_t *text, size_t at) {
+  for (size_t back = 1; back <= 8 && back <= at; back++) {
+    uint32_t insn = text[at - back];
+    int nr = svc_number(insn);
+    if (nr >= 0) return nr;
+    if (!svc_argument_instruction(insn)) break;
+  }
+  return -1;
+}
+
+static inline int svc_branch(uintptr_t from, uintptr_t to, uint32_t *out) {
+  int64_t delta = (int64_t)to - (int64_t)from;
+  if ((delta & 3) || delta < -0x8000000LL || delta >= 0x8000000LL) return 0;
+  *out = 0x14000000U | ((uint32_t)(delta / 4) & 0x03ffffffU);
+  return 1;
+}
+
+#if defined(__aarch64__) && !defined(FP_SVC_ENCODINGS_ONLY)
+#include <asm/hwcap.h>
+#include <link.h>
+#include <sys/uio.h>
+#include <signal.h>
+
+static __thread uintptr_t svc_busy __attribute__((tls_model("initial-exec")));
+static unsigned svc_sites, svc_pages;
+static unsigned long svc_fast, svc_slow;
+static unsigned long long svc_scan_ns, svc_patch_ns;
+
+#include "svc-dispatch.h"
+#include "svc-stack.h"
+
+static long svc_original(const long *r) {
+  register long x0 __asm__("x0") = r[0];
+  register long x1 __asm__("x1") = r[1];
+  register long x2 __asm__("x2") = r[2];
+  register long x3 __asm__("x3") = r[3];
+  register long x4 __asm__("x4") = r[4];
+  register long x5 __asm__("x5") = r[5];
+  register long x8 __asm__("x8") = r[8];
+  __asm__ volatile("svc #0" : "+r"(x0) : "r"(x1), "r"(x2), "r"(x3), "r"(x4), "r"(x5), "r"(x8) : "memory", "cc");
+  return x0;
+}
+
+__attribute__((used, visibility("hidden")))
+long fp_svc_dispatch(const long *r) {
+  int saved_errno = errno;
+  long result = svc_blocked(r);
+  uintptr_t frame = (uintptr_t)r;
+  if (result == FP_SLOW && (!svc_busy || frame >= svc_busy)) {
+    uintptr_t previous = svc_busy;
+    svc_busy = frame;
+    if (svc_stack_room(frame)) { result = svc_path_call(r); svc_busy = 0; }
+    else svc_busy = previous;
+  }
+  if (result == FP_SLOW) {
+    __atomic_fetch_add(&svc_slow, 1, __ATOMIC_RELAXED);
+    result = svc_original(r);
+  } else __atomic_fetch_add(&svc_fast, 1, __ATOMIC_RELAXED);
+  errno = saved_errno;
+  return result;
+}
+
